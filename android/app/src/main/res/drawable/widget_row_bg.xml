<?xml version="1.0" encoding="utf-8"?>
<!-- Each commit sits on a tonal (secondary container) surface, a step darker than the widget in light mode and a step lighter in dark mode. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26888888">
    <item>
        <shape>
            <solid android:color="@color/widget_row_bg" />
            <corners android:radius="@android:dimen/system_app_widget_inner_radius" />
        </shape>
    </item>
</ripple>
