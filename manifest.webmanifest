    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "docs/screenshots/home-light.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "Repositories sorted by latest push, with pinned repos on top" },
    { "src": "docs/screenshots/repo-light.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "Commits grouped by day, with a branch picker" },
    { "src": "docs/screenshots/commit-light.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "Commit details with colored diffs" },
    { "src": "docs/screenshots/repo-dark.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "Dark theme follows your system setting" }
  ]
