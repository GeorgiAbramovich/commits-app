{
  "id": "./",
  "name": "Commits",
  "short_name": "Commits",
  "description": "A simple, read-only browser for the latest GitHub commits across your organizations.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#131318",
